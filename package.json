{
  "name": "emissor-nfse-nacional",
  "version": "1.0.0",
  "private": true,
  "description": "Emissor de NFS-e direto na API do Sistema Nacional NFS-e, sem custo por nota: um servidor Node.js com banco SQLite.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --openssl-legacy-provider --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.ts",
    "dev": "node --openssl-legacy-provider --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.ts",
    "certificate": "node --openssl-legacy-provider --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/certificate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "~2.1.6",
    "hono": "^4.13.18",
    "pdf-lib": "^1.17.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
