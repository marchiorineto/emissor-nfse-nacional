# Copie para .env e preencha. O `pnpm run certificate <arquivo.pfx>` cria o .env a partir deste arquivo, se ainda não
# existir, e preenche CERT_PFX_B64, CERT_PASSWORD e, se estiver vazio, API_TOKEN.

# "restricted" é a produção restrita, o ambiente de testes do governo; "production" emite notas de verdade.
NFSE_ENVIRONMENT=restricted
# CNPJ do prestador do serviço.
ISSUER_CNPJ=
# Código IBGE do município do CNPJ (7 dígitos).
ISSUER_CITY_CODE=
# Inscrição municipal. Deixe vazio, a menos que o município tenha cadastrado a empresa no Cadastro Nacional de
# Contribuintes (CNC). Com esse cadastro, ela é obrigatória (erro E0116); sem ele, o governo recusa a nota com o erro
# E0120.
ISSUER_MUNICIPAL_SUBSCRIPTION=
# Situação no Simples Nacional: "2" = MEI; "3" = ME/EPP. O valor "1" (não optante) é aceito, mas o emissor ainda não
# atende empresas fora do Simples: veja docs/quem-pode-usar.md.
ISSUER_SIMPLES_OPTION=
# Só para ME/EPP. Regime de apuração: "1" = tributos federais e municipal pelo Simples Nacional; "2" = federais pelo
# Simples e ISSQN por fora; "3" = federais e municipal por fora do Simples.
ISSUER_SIMPLES_APURATION=1
# Só para ME/EPP. Alíquota nominal da faixa do Simples Nacional em que a empresa está, que sai na nota como valor
# aproximado dos tributos (Lei 12.741/2012), com ponto e 2 casas decimais, por exemplo "6.00". Peça ao seu contador e
# atualize quando a empresa mudar de faixa.
ISSUER_SIMPLES_TOTAL_TAX_PERCENT=
# Série das DPS, de 1 a 49999: é a faixa que o governo reserva à API.
DPS_SERIES=1

# Token que os seus sistemas usam no cabeçalho Authorization. Também assina os links públicos das notas: trocar o token
# invalida os links já enviados.
API_TOKEN=
# Certificado A1 (e-CNPJ) em base64 e a senha. Preenchidos pelo `pnpm run certificate`.
CERT_PFX_B64=
CERT_PASSWORD=
# Senha do painel (/admin), guardada só como hash scrypt. Preencha com o `pnpm run admin-password`, nunca à mão.
# Vazio desliga o painel: /login e /admin respondem 404.
ADMIN_PASSWORD=

# Arquivo do banco SQLite. Faça backup dele: é onde ficam as notas e o contador das DPS.
DATABASE_PATH=data/emissor-nfse.db
PORT=8080
# Endereço público da API, para os links das notas, quando ela fica atrás de um proxy (por exemplo,
# https://nfse.seudominio.com.br). Vazio usa o endereço de cada chamada.
PUBLIC_URL=
